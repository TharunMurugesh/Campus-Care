# --- Database ---
# Use the values created by `sudo bash setup_db.sh`.
# This dedicated app role (NOT the postgres superuser) is what the app connects with.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_issue_system
DB_USER=campus_app
DB_PASSWORD=change_me_to_a_strong_password

# --- Flask ---
# Generate a strong key with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_long_random_hex_string

# dev | production
FLASK_ENV=dev

# --- Connection pool (optional tuning) ---
# Min idle connections kept open, max concurrent connections the pool will open.
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Production session cookie ---
# Set to 1 in production (requires HTTPS).
SESSION_COOKIE_SECURE=0
